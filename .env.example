DATABASE_URL="postgresql://muhammad@localhost:5433/homeinn_dev?schema=public"
TEST_DATABASE_URL="postgresql://muhammad@localhost:5433/homeinn_test?schema=public"
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-in-production"
UPLOAD_DIR="./uploads"
PUBLIC_MEDIA_BASE_URL="http://localhost:4000/media"
PORT=4000

NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
WEB_ORIGIN="http://localhost:3000,http://localhost:3100"

# ---- Optional; all off or defaulted when unset ----

# Bind address for the API (the host uses 127.0.0.1) and the site's port
# (deploy/start-web.sh).
# HOST=127.0.0.1
# WEB_PORT=3200

# Where the web server itself reaches the API (server-only, read at run time).
# API_INTERNAL_URL="http://127.0.0.1:4000/api"

# Instant updates: the API tells the web app which cached pages an edit touched.
# The same secret on both apps.
# REVALIDATE_SECRET="a-long-random-string"
# WEB_REVALIDATE_URL="http://127.0.0.1:3000/api/revalidate"

# Email to the company on each new enquiry (Gmail needs an app password).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="homeinnbd14@gmail.com"
# SMTP_PASS="gmail-app-password"
# LEAD_NOTIFY_TO="homeinnbd14@gmail.com"

# Express "trust proxy". Unset trusts the loopback proxy, right for a tunnel on
# the same machine. Numbers and true/false are read as Express means them.
# TRUST_PROXY=loopback

# Login attempts per address per 15 minutes (default 10).
# LOGIN_THROTTLE_LIMIT=10
